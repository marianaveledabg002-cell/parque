<%- include('../cabecalho')%>


    <div>
        <tr><a href="../paleontologo"> ← Voltar </a></tr>
        <h3>Alterar Paleontólogo</h3>


        <form method="POST">
            <p>ID</p>
            <input type="text" placeholder="Nome do Paleontólogo" name="id" value="<%=paleontologo.id%>">
            <p>Nome</p>
            <input type="text" placeholder="Nome do Paleontólogo" name="nome"  value="<%=paleontologo.nome%>">
            <br>
            <p>Nascimento</p>
            <input type="number" value="2026" name="nascimento"  value="<%=paleontologo.nascimento%>">
            <br>
            <p>Descoberta</p>
            <input type="text" placeholder="Espécies, Dinossauros, etc..." name="descoberta"  value="<%=paleontologo.descoberta%>">
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>
    </body>

    </html>